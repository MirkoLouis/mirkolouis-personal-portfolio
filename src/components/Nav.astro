---
// Sticky top navigation with in-page anchors
import { site } from "../data/site";

const links = [
    { href: "#about", label: "About" },
    { href: "#projects", label: "Projects" },
    { href: "#stack", label: "Stack" },
    { href: "#contact", label: "Contact" },
];
---
<header class="nav">
    <div class="container inner">
        <a class="brand" href="#top">{site.title}</a>
        <nav aria-label="Main">
            <ul>
                {links.map((link) => (
                    <li><a href={link.href}>{link.label}</a></li>
                ))}
            </ul>
        </nav>
    </div>
</header>

<style>
    /* Translucent sticky bar above the intro section */
    .nav {
        position: sticky;
        top: 0;
        z-index: 10;
        background: rgb(255 255 255 / 0.85);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid var(--border);
    }

    /* Same centered column as the intro, so the brand lines up with the intro text */
    .inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        height: 60px;
    }

    .brand {
        font-weight: 700;
        color: var(--text);
        text-decoration: none;
        white-space: nowrap;
    }

    ul {
        display: flex;
        gap: 20px;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    ul a {
        color: var(--text);
        text-decoration: none;
        font-weight: 500;
    }

    ul a:hover {
        color: var(--accent-text);
    }

    /* Narrow phones: hide the brand so the links fit */
    @media (max-width: 400px) {
        .brand {
            display: none;
        }

        .inner {
            justify-content: center;
        }
    }
</style>
